# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[Makefile]
indent_style = tab

# MT940 fixtures keep the CRLF line endings and trailing spaces of the export they imitate.
[src-tauri/tests/fixtures/statements/mt940/*.sta]
end_of_line = unset
trim_trailing_whitespace = false

# OFX fixtures keep the CRLF line endings and trailing spaces of the export they imitate.
[src-tauri/tests/fixtures/statements/ofx/*.ofx]
end_of_line = unset
trim_trailing_whitespace = false

# QIF fixtures keep the CRLF line endings (and the legacy code page) of the export they imitate.
[src-tauri/tests/fixtures/statements/qif/*.qif]
end_of_line = unset
trim_trailing_whitespace = false
charset = unset
