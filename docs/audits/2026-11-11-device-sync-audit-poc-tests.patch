+#[tokio::test]
+async fn audit_m2_acknowledged_envelope_the_relay_drops_is_never_sent_again() {
+    use crate::services::sync::engine::push::push_all;
+    let vault = vault().await;
+    institution(&vault.a.lock(), "a1");
+    push_all(&vault.relay, &vault.a, &vault.creds).await.expect("push 1");
+    vault.relay.drop_op(1);
+    institution(&vault.a.lock(), "a2");
+    push_all(&vault.relay, &vault.a, &vault.creds).await.expect("push 2");
+    assert!(pull_all(&vault.relay, &vault.a, &vault.creds, NOW).await.expect("A").done());
+    let b = pull_all(&vault.relay, &vault.b, &vault.creds, NOW).await.expect("B");
+    assert_eq!(b.stop, Some(PullStop::Gap));
+    let a = vault.a.lock();
+    assert_eq!(
+        count(&a, "SELECT (SELECT COUNT(*) FROM sync_unsent)+(SELECT COUNT(*) FROM sync_outbox)"),
+        0
+    );
+}
