    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
