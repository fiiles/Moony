CREATE INDEX idx_crypto_value_history_ticker ON crypto_value_history(ticker)

== index idx_crypto_value_history_ticker_date ==
CREATE INDEX idx_crypto_value_history_ticker_date ON crypto_value_history(ticker, recorded_at)

