CREATE INDEX idx_categorization_rules_iban ON categorization_rules(iban_pattern) WHERE iban_pattern IS NOT NULL

== index idx_categorization_rules_priority ==
CREATE INDEX idx_categorization_rules_priority ON categorization_rules(priority DESC, is_active)

== index idx_crypto_transactions_ticker ==
CREATE INDEX idx_crypto_transactions_ticker ON crypto_transactions(ticker)

